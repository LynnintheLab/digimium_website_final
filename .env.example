# Hostinger Node.js Web App (server-side environment variables)
APP_ORIGIN=
ADMIN_EMAIL=
ADMIN_AUTH_SECRET=
# Optional stable encryption secret for delivered account details
ORDER_FULFILLMENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional customer Google login; configure both values to enable it
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional customer Telegram login; a separate bot per environment
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Private scheduler Bearer secret (at least 32 characters); never put it in a URL
NOTIFICATIONS_CRON_SECRET=
# Admin personal-chat alerts; optional dedicated token, otherwise use TELEGRAM_BOT_TOKEN
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_BOT_TOKEN=
# Dedicated private Running HUB Admin bot
RUNNINGHUB_ADMIN_TELEGRAM_BOT_TOKEN=
RUNNINGHUB_ADMIN_TELEGRAM_OWNER_ID=
RUNNINGHUB_ADMIN_TELEGRAM_WEBHOOK_SECRET=
RUNNINGHUB_ADMIN_TELEGRAM_PAYMENT_TOPIC_ID=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Existing ChatGPT Sites target only
ADMIN_EMAILS=
